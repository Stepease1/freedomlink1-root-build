{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "Run FL1 Diagnostics",
            "type": "shell",
            "command": "powershell -ExecutionPolicy Bypass -File ./system/diagnostics/test-introspection.ps1",
            "options": {
                "cwd": "${workspaceFolder}/unified"
            },
            "problemMatcher": []
        },
        {
            "label": "Lint Current Sovereign Document",
            "type": "process",
            "command": "npm.cmd",
            "args": ["run", "lint:style", "--", "${file}"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        },
        {
            "label": "Lint Staged Sovereign Documents",
            "type": "process",
            "command": "npm.cmd",
            "args": ["run", "lint:style", "--", "--staged"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}